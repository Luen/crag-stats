{
	"name": "crag-stats",
	"private": true,
	"version": "0.12.0",
	"description": "Self-hosted climbing analytics for theCrag",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:changed": "vitest run --changed origin/main",
		"test:related": "vitest related --run",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"lint": "prettier --check --cache --cache-strategy content . && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
		"format": "prettier --write --cache --cache-strategy content .",
		"db:migrate": "node scripts/migrate.mjs",
		"worker": "node scripts/worker.mjs",
		"start": "node scripts/docker-entrypoint.mjs node scripts/server.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"yaml": "2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"better-sqlite3": "^13.0.3",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "^0.45.4",
		"impers": "0.1.2",
		"marked": "^18.1.3",
		"node-cron": "^4.6.0"
	}
}
