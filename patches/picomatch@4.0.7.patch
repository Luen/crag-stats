+// Unbounded wildcards inside repeated extglobs nest unbounded quantifiers.
+// Include single branches and nested bodies; preserve escapes and character classes.
+const hasUnboundedWildcard = body => {
+  let bracket = false;
+  for (let i = 0; i < body.length; i++) {
+    const ch = body[i];
+    if (ch === '\\') { i++; continue; }
+    if (ch === '[') { bracket = true; continue; }
+    if (ch === ']' && bracket) { bracket = false; continue; }
+    if (!bracket && ch === '*' && body[i + 1] !== '(') return true;
+  }
+  return false;
+};
+
 const analyzeRepeatedExtglob = (body, options) => {
+  if (hasUnboundedWildcard(body)) return { risky: true };
   if (options.maxExtglobRecursion === false) {
     return { risky: false };
   }
