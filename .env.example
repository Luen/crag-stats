# Optional password gate (leave empty to disable)
APP_PASSWORD=

# Password scope: settings (admin only — default) | all (entire UI)
AUTH_SCOPE=settings

# Session secret for signed cookies + worker sync header (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Tip: put Cloudflare Access in front of /settings* and /login* as a second factor.
# App login also rate-limits failed attempts (5 / 15 min per IP, in-memory).

# SQLite database path (Docker default: /data/crag-stats.sqlite)
DATABASE_PATH=./data/crag-stats.sqlite

# theCrag Logbook Read API key (Supporters). See:
# https://www.thecrag.com/en/article/logbookreadapi
# WARNING: keys grant read access to private notes. Never commit real keys.
THECRAG_API_KEY=

# Show your private ascent notes in the logbook (default false). Only people who can open
# Settings see them: anyone if APP_PASSWORD is empty, otherwise only when logged in.
# Meant for offline / home-network installs. The Settings toggle overrides this.
# SHOW_PRIVATE_NOTES=false

# Opt-in: read public FA/FFA route history from theCrag in the background (default false).
# Each route is checked once, 20 routes per run, one request a second, after each sync.
# theCrag blocks plain server requests to its route API, so this uses browser impersonation
# (impers): at your own risk under theCrag's terms. See docs/dev/ROUTE_HISTORY.md.
# ROUTE_HISTORY_IMPORT=false

# Sync schedule (node-cron expression). Default: daily at 06:00 local time.
SYNC_CRON=0 6 * * *

# Preferred display grade system: ewbank | french | yds | v_scale | font
PREFERRED_GRADE_SYSTEM=ewbank
# Dates/times are shown in this locale + time zone on server and client (default en-AU, host zone)
# DISPLAY_LOCALE=en-AU
# TZ=Australia/Brisbane

# Host / port (in-container listen — leave as-is for Docker)
HOST=0.0.0.0
PORT=3000

# Public URL. Usually not needed: plain-HTTP LAN access and proxies that send
# X-Forwarded-Proto (Cloudflare Tunnel, nginx, Caddy, Traefik) are detected automatically.
# Set it if forms fail with "Cross-site POST form submissions are forbidden" behind a
# proxy that doesn't send X-Forwarded-Proto.
# ORIGIN=https://crag.example.com

# docker-compose.ghcr.yml only — host publish (defaults: loopback :8097)
# HOST_BIND=127.0.0.1
# HOST_PORT=8097
# CRAG_STATS_IMAGE_TAG=v0.2.0
